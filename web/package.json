{
  "name": "kabuqina-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Kabuqina onboarding wizard + UI overlays. Loaded by the Tauri shell before handing off to the local dashboard.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-production-bundle.mjs",
    "lint": "eslint .",
    "test:desktop-delivery": "node src/lib/desktopDelivery.test.mjs",
    "test:desktop-startup": "node src/lib/desktopStartup.test.mjs",
    "test:chat-ux": "node src/chat/chatUx.test.mjs",
    "test:chat-display": "node src/chat/chatDisplay.test.mjs",
    "test:capture-index": "node src/chat/study/captureIndex.test.mjs",
    "test:knowledge-points": "node src/chat/study/knowledgePoints.test.mjs",
    "test:components": "vitest run --config vitest.config.ts",
    "test:components:watch": "vitest --config vitest.config.ts",
    "test:ui-prefs": "node src/lib/ui-prefs.test.mjs",
    "test:gateway-ux": "node src/advanced/gatewayUx.test.mjs",
    "test:legacy-upgrade": "vitest run --config vitest.config.ts src/advanced/settings/SettingsLegacyChannels.test.tsx",
    "test:capabilities-page": "node src/advanced/capabilitiesPage.test.mjs",
    "test:settings-load-packages": "node src/advanced/settingsLoadPackages.test.mjs",
    "test:settings-update": "node src/advanced/settingsUpdate.test.mjs",
    "test:onboarding-providers": "node src/onboarding/providerUx.test.mjs",
    "test:companion-ux": "node src/companion/companionUx.test.mjs",
    "export:brand-svgs": "npx vite-node src/components/brand/exportBrandSvgs.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.577.0",
    "pptxgenjs": "^3.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.1",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
