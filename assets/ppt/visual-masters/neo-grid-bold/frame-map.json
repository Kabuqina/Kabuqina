  },
  "tokens": {
    "background": "#ECECE8",
    "paper": "#F5F4EF",
    "ink": "#0A0A0A",
    "accent": "#E6FF3D",
    "muted": "#8A8A85"
  },
  "rules": [
    "Use neon yellow only as the signature accent for highlighted panels, labels, metric emphasis, and key blocks.",
    "Keep the palette high-contrast: off-white paper, black ink, neon yellow.",
    "Prefer uppercase, geometric, graphic hierarchy.",
    "Avoid extra accent colors, shadows, soft gradients, or warm editorial decoration.",
    "Reserve dense matrix and consulting frames for evidence-heavy student reports and project defense analysis."
  ],
  "frames": [
    {
      "role": "cover",
      "source_html_layout": "s-cover",
      "current_slide": 1,
      "writer_slide_types": ["cover", "title"],
