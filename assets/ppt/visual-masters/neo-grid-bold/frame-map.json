{
  "version": 1,
  "visual_master": "neo_grid_bold",
  "implementation_level": "html_background_editable_overlay",
  "source": {
    "html_template_dir": "assets\\ppt\\visual-masters\\neo-grid-bold\\neo-grid-bold_html",
    "current_pptx": "template.pptx",
    "background_dir": "backgrounds",
