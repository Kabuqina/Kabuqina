      "content_slots": ["title", "metadata", "visual_blocks"]
    },
    {
      "role": "toc",
      "source_html_layout": "s-toc",
      "current_slide": 2,
      "writer_slide_types": ["agenda", "toc"],
      "purpose": "Six-item contents grid with alternating paper, neon, and ink cells.",
      "content_slots": ["items"]
    },
    {
      "role": "stats",
      "source_html_layout": "s-stats",
      "current_slide": 3,
      "writer_slide_types": ["stats", "key_findings"],
      "purpose": "Large metric statement with supporting stats and oversized result block.",
      "content_slots": ["headline", "metrics", "summary"]
    },
    {
      "role": "features",
      "source_html_layout": "s-features",
      "current_slide": 4,
      "writer_slide_types": ["three_cards", "features"],
      "purpose": "Three-card feature or finding summary.",
      "content_slots": ["headline", "cards"]
    },
    {
      "role": "chart",
